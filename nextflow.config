/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/differentialabundance Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
includeConfig 'conf/params.config'

// All publishing goes through main.nf's `output {}` block; `-output-dir` (or a
// config-level `outputDir`) sets where it writes.
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }

    // Analysis profiles (single-run mode)
    rnaseq                    { includeConfig 'conf/profile/rnaseq/rnaseq.config'                    }
    rnaseq_deseq2_gsea        { includeConfig 'conf/profile/rnaseq/rnaseq_deseq2_gsea.config'        }
    rnaseq_deseq2_gprofiler2  { includeConfig 'conf/profile/rnaseq/rnaseq_deseq2_gprofiler2.config'  }
    rnaseq_limma              { includeConfig 'conf/profile/rnaseq/rnaseq_limma.config'              }
    rnaseq_limma_gsea         { includeConfig 'conf/profile/rnaseq/rnaseq_limma_gsea.config'         }
    rnaseq_limma_gprofiler2   { includeConfig 'conf/profile/rnaseq/rnaseq_limma_gprofiler2.config'   }
    rnaseq_limma_decoupler    { includeConfig 'conf/profile/rnaseq/rnaseq_limma_decoupler.config'    }
    rnaseq_dream              { includeConfig 'conf/profile/rnaseq/rnaseq_dream.config'              }
    rnaseq_dream_decoupler    { includeConfig 'conf/profile/rnaseq/rnaseq_dream_decoupler.config'    }
    rnaseq_propd              { includeConfig 'conf/profile/rnaseq/rnaseq_propd.config'              }
    rnaseq_propd_grea         { includeConfig 'conf/profile/rnaseq/rnaseq_propd_grea.config'         }
    affy                      { includeConfig 'conf/profile/affy/affy.config'                        }
    affy_limma_gsea           { includeConfig 'conf/profile/affy/affy_limma_gsea.config'             }
    affy_limma_gprofiler2     { includeConfig 'conf/profile/affy/affy_limma_gprofiler2.config'       }
    maxquant                  { includeConfig 'conf/profile/maxquant/maxquant.config'                }
    soft                      { includeConfig 'conf/profile/soft/soft.config'                        }
    generic_matrix            { includeConfig 'conf/profile/generic_matrix/generic_matrix.config'    }
    generic_matrix_dream      { includeConfig 'conf/profile/generic_matrix/generic_matrix_dream.config' }

    // Basic test profiles
    test              { includeConfig 'conf/test.config'              }
    test_full         { includeConfig 'conf/test_full.config'         }
    cache_default     { includeConfig 'conf/cache_default.config'     }

    // More test profiles
    test_rnaseq_deseq2_gsea        { includeConfig 'conf/test/rnaseq/rnaseq_deseq2_gsea.config'             }
    test_rnaseq_deseq2_gprofiler2  { includeConfig 'conf/test/rnaseq/rnaseq_deseq2_gprofiler2.config'       }
    test_rnaseq_limma_gsea         { includeConfig 'conf/test/rnaseq/rnaseq_limma_gsea.config'              }
    test_rnaseq_limma_gprofiler2   { includeConfig 'conf/test/rnaseq/rnaseq_limma_gprofiler2.config'        }
    test_rnaseq_limma_decoupler    { includeConfig 'conf/test/rnaseq/rnaseq_limma_decoupler.config'         }
    test_rnaseq_dream_decoupler    { includeConfig 'conf/test/rnaseq/rnaseq_dream_decoupler_complex.config' }
    test_rnaseq_propd_grea         { includeConfig 'conf/test/rnaseq/rnaseq_propd_grea.config'              }
    test_affy_limma_gsea           { includeConfig 'conf/test/affy/affy_limma_gsea.config'                  }
    test_affy_limma_gprofiler2     { includeConfig 'conf/test/affy/affy_limma_gprofiler2.config'            }
    test_maxquant                  { includeConfig 'conf/test/maxquant/maxquant.config'                     }
    test_soft                      { includeConfig 'conf/test/soft/soft.config'                             }
}


// Load nf-core/differentialabundance custom profiles from different institutions.

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/differentialabundance.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled   = true
    file      = "execution_timeline_${params.trace_report_suffix}.html"
    directory = 'pipeline_info'
}
report {
    enabled   = true
    file      = "execution_report_${params.trace_report_suffix}.html"
    directory = 'pipeline_info'
}
trace {
    enabled   = true
    file      = "execution_trace_${params.trace_report_suffix}.txt"
    directory = 'pipeline_info'
}
dag {
    enabled   = true
    file      = "pipeline_dag_${params.trace_report_suffix}.html"
    directory = 'pipeline_info'
}

manifest {
    name            = 'nf-core/differentialabundance'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Oskar Wacker',
            affiliation: '',
            email: '',
            github: '',
            contribution: ['author'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Jonathan Manning',
            affiliation: 'Seqera',
            email: '',
            github: '@pinin4fjords',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0000-0002-3483-8456'
        ],
        [
            name: 'Suzanne Jin',
            affiliation: 'Centre for Genomic Regulation (CRG)',
            email: '',
            github: '@suzannejin',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Cristina Araiz',
            affiliation: 'Centre for Genomic Regulation (CRG)',
            email: '',
            github: '@caraiz2001',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Björn Langer',
            affiliation: 'Centre for Genomic Regulation (CRG)',
            email: '',
            github: '@blanger',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Júlia Mir Pedrol',
            affiliation: 'Centre for Genomic Regulation (CRG)',
            email: '',
            github: '@mirpedrol',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ]
    ]
    homePage        = 'https://github.com/nf-core/differentialabundance'
    description     = 'Differential abundance analysis'
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=26.09.0-edge'
    version         = '2.0.0'
    doi             = '10.5281/zenodo.7568000'
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.2-channel.4' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes", "igenomes_base"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
