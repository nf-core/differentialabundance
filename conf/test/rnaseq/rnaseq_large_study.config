/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the large-study RNA-seq test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Overrides for a study with many samples. The inputs (`input`, `matrix` and
    `contrasts`) are generated by tests/test_large_study.nf.test, so this is
    not a standalone profile.
----------------------------------------------------------------------------------------
*/

includeConfig '../../profile/rnaseq/rnaseq.config'

params {
    study_name = 'large_study'

    // Exploratory
    exploratory_main_variable = 'contrasts'

    // The generated matrix is too small for the nsub default value
    deseq2_vst_nsub = 500
}
