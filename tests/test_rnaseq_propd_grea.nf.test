nextflow_pipeline {

    name "Test Workflow main.nf - DIFFERENTIALABUNDANCE (propd + grea)"
    script "../main.nf"
    tag "rnaseq_propd_grea"
    tag "pipeline"

    test("Test rnaseq propd + grea profile") {

        options "-output-dir $outputDir"
        config "${projectDir}/conf/test/rnaseq/rnaseq_propd_grea.config"

        then {
            // stable_name: All files + folders in the output directory with a stable name
            def stable_name = getAllFilesFromDir(outputDir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in the output directory with stable content
            def stable_path = getAllFilesFromDir(outputDir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_differentialabundance_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
                )
        }
    }
}
