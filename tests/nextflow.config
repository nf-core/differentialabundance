/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/


// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/differentialabundance/'
}

// fixes S3 access issues on self-hosted runners
aws.client.anonymous = true

// nf-test sets an absolute trace.file, which Nextflow rejects together with the pipeline's trace.directory
trace.directory = null


process {
    resourceLimits = [
        cpus: 1,
        memory: '6.GB',
        time: '6.h'
    ]
}
